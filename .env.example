# Copy this to .env and fill in values before running.
# NEVER commit .env to git.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_32_random_chars

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key

# PostgreSQL (asyncpg DSN for the app, psycopg2 DSN for Alembic)
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev@localhost:5432/nexus
DATABASE_URL_SYNC=postgresql+psycopg2://nexus:nexus_dev@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ENVIRONMENT=development
DEBUG=true
